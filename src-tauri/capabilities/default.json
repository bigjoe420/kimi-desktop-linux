{
  "identifier": "default",
  "description": "Default capabilities for the Kimi desktop wrapper",
  "local": true,
  "remote": {
    "urls": ["https://kimi.moonshot.cn"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
